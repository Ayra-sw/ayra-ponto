# Copie este arquivo para ".env" e preencha com os dados do SEU projeto Supabase
# (Supabase → seu projeto → Project Settings → API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# NUNCA suba o arquivo ".env" (com os valores reais) para o GitHub.
# Na Vercel, essas duas variáveis são configuradas em Settings > Environment Variables.
